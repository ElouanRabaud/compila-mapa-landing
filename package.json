{
  "name": "compila-mapa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/sync-config.mjs && node scripts/build.mjs",
    "build:production": "node scripts/sync-config.mjs && node scripts/build.mjs --production",
    "dev": "node --env-file-if-exists=.dev.vars scripts/preview.mjs",
    "dev:cloudflare": "wrangler pages dev public --ip 127.0.0.1 --port 8788 --binding SITE_ORIGIN=http://127.0.0.1:8788",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "snapshot": "node scripts/snapshot.mjs",
    "deploy": "npm run build:production && wrangler pages deploy public --project-name compila-mapa"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "wrangler": "^4.151.1"
  }
}
